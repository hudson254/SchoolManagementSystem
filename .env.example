# Database Configuration
DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
DB_NAME=SchoolManagementSystem
DB_USER=sms_user

# JWT Configuration
JWT_SECRET=CHANGE_ME_GENERATE_64_CHAR_SECRET
JWT_ISSUER=SMSAPI
JWT_AUDIENCE=SMSWeb
JWT_EXPIRY=60

# SSL Configuration
SSL_PASSWORD=CHANGE_ME

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=CHANGE_ME

# Backup Configuration
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=30

# Monitoring
GRAFANA_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# Application
API_URL=http://localhost:5000/api
GRAFANA_URL=http://localhost:3001

# Administrator Credentials (REQUIRED for seeding)
ADMIN_EMAIL=CHANGE_ME@school.edu
ADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# Swagger Configuration (enable only in development)
Swagger__Enabled=false

# Features
ENABLE_MFA=false
ENABLE_PWA=true

# Rate Limiting
RATE_LIMIT_PERMIT=100
RATE_LIMIT_WINDOW=60
