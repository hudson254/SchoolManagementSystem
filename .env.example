# =============================================================================
# School Management System - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# =============================================================================

# --- Database Configuration ---
DB_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_AT_LEAST_16_CHARS
DB_NAME=SchoolManagementSystem
DB_USER=sms_user

# --- JWT Configuration ---
# Generate using: openssl rand -base64 64
# Minimum 64 characters, must provide at least 512 bits of entropy
JWT_SECRET=CHANGE_ME_GENERATE_64_CHAR_SECRET_MINIMUM
JWT_ISSUER=SMSAPI
JWT_AUDIENCE=SMSWeb
JWT_EXPIRY=60

# --- SSL Configuration (Development Only) ---
SSL_PASSWORD=CHANGE_ME

# --- SMTP Configuration (DISABLED by default for LAN deployment) ---
# SMTP is intentionally disabled. Email features (password resets, notifications)
# are handled through admin-mediated workflows.
# To enable SMTP, set Host, Port, Username, Password, From and add "Enabled": true
# to the SMTP section in appsettings.Production.json.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- Frontend URL (REQUIRED in production) ---
# Set to the actual URL where the frontend is served.
# Example: FRONTEND_URL=https://sms.school.edu
FRONTEND_URL=CHANGE_ME_TO_FRONTEND_URL

# --- Backup Configuration ---
BACKUP_INTERVAL=86400
BACKUP_RETENTION_DAYS=30

# --- Monitoring ---
GRAFANA_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD

# --- Application URLs ---
API_URL=/api
GRAFANA_URL=http://localhost:3001

# --- Administrator Credentials (REQUIRED for seeding) ---
ADMIN_EMAIL=CHANGE_ME@school.edu
ADMIN_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_AT_LEAST_12_CHARS
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator

# --- Swagger Configuration (enable only in development) ---
Swagger__Enabled=false

# --- Features ---
ENABLE_MFA=false
ENABLE_PWA=true

# --- Rate Limiting ---
RATE_LIMIT_PERMIT=100
RATE_LIMIT_WINDOW=60
