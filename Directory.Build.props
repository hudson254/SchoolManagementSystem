<Project>
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
<!-- AutoMapper (locked to 12.x for Extensions compatibility) -->
    <PackageReference Update="AutoMapper" Version="12.0.1" />
    <PackageReference Update="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />

    <!-- FluentValidation -->
    <PackageReference Update="FluentValidation" Version="11.11.0" />
    <PackageReference Update="FluentValidation.DependencyInjectionExtensions" Version="11.11.0" />

    <!-- MediatR -->
    <PackageReference Update="MediatR" Version="12.4.1" />

    <!-- Microsoft.Extensions -->
    <PackageReference Update="Microsoft.Extensions.Logging.Abstractions" Version="9.0.3" />
    <PackageReference Update="Microsoft.Extensions.Options" Version="9.0.3" />
    <PackageReference Update="Microsoft.Extensions.Caching.Memory" Version="9.0.3" />
    <PackageReference Update="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.3" />
    <PackageReference Update="Microsoft.Extensions.Identity.Core" Version="9.0.3" />
    <PackageReference Update="Microsoft.Extensions.Identity.Stores" Version="9.0.3" />

    <!-- EF Core -->
    <PackageReference Update="Microsoft.EntityFrameworkCore" Version="9.0.3" />
    <PackageReference Update="Microsoft.EntityFrameworkCore.Tools" Version="9.0.3" />
    <PackageReference Update="Microsoft.EntityFrameworkCore.Design" Version="9.0.3" />
    <PackageReference Update="Microsoft.EntityFrameworkCore.InMemory" Version="9.0.3" />
    <PackageReference Update="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.3" />
    <PackageReference Update="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.3" />
    <PackageReference Update="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.3" />
    <PackageReference Update="Microsoft.AspNetCore.Mvc.Testing" Version="9.0.3" />
    <PackageReference Update="Microsoft.AspNetCore.TestHost" Version="9.0.3" />

    <!-- JWT -->
    <PackageReference Update="System.IdentityModel.Tokens.Jwt" Version="8.4.0" />
    <PackageReference Update="Microsoft.IdentityModel.Tokens" Version="8.4.0" />

    <!-- Reporting -->
    <PackageReference Update="EPPlus" Version="7.6.1" />
    <PackageReference Update="QuestPDF" Version="2024.12.0" />
    <PackageReference Update="CsvHelper" Version="33.0.1" />

    <!-- Swagger -->
    <PackageReference Update="Swashbuckle.AspNetCore" Version="7.2.0" />
    <PackageReference Update="Swashbuckle.AspNetCore.Annotations" Version="7.2.0" />

    <!-- Testing -->
    <PackageReference Update="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Update="xunit" Version="2.9.3" />
    <PackageReference Update="xunit.runner.visualstudio" Version="3.0.1" />
    <PackageReference Update="Moq" Version="4.20.72" />
    <PackageReference Update="FluentAssertions" Version="6.12.2" />

  </ItemGroup>
</Project>
