<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- SMS.Application supplies the INotificationRealtimePublisher port that the
         SignalR publisher implements. It is a one-way reference (Application does not
         depend on Notifications), so it introduces no cycle. -->
    <ProjectReference Include="..\SMS.Application\SMS.Application.csproj" />
    <ProjectReference Include="..\SMS.Domain\SMS.Domain.csproj" />
    <ProjectReference Include="..\SMS.Infrastructure\SMS.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- NotificationHub exposes an internal test seam (GroupsOverride) so the
         security-critical group-join logic can be asserted directly. Production
         code never sets it; only the unit-test assembly can reach it. -->
    <InternalsVisibleTo Include="SMS.UnitTests" />
  </ItemGroup>

</Project>
