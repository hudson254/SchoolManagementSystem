{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5433;Database=sms_test;Username=testuser;Password=testpass123;Minimum Pool Size=1;Maximum Pool Size=20;",
    "HangfireConnection": ""
  },
  "JwtSettings": {
    "Secret": "test-jwt-secret-key-that-is-at-least-64-characters-long-for-testing-purposes-only",
    "Issuer": "SMSAPI",
    "Audience": "SMSWeb",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "SMTP": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "From": "",
    "EnableSsl": true
  },
  "FileStorage": {
    "Path": "uploads",
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [".pdf", ".doc", ".docx", ".ppt", ".pptx", ".xls", ".xlsx", ".jpg", ".jpeg", ".png", ".zip"]
  },
  "Tenant": {
    "DefaultTenantId": "11111111-1111-1111-1111-111111111111"
  },
  "Frontend": {
    "Url": "http://localhost:5173"
  },
  "RateLimiting": {
    "PermitLimit": 1000,
    "WindowMinutes": 1
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  }
}
