{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "",
    "HangfireConnection": ""
  },
  "JwtSettings": {
    "Secret": "",
    "Issuer": "SMSAPI",
    "Audience": "SMSWeb",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 3
  },
  "SMTP": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "From": "",
    "EnableSsl": true
  },
  "FileStorage": {
    "Path": "/var/data/sms/uploads",
    "MaxFileSizeMB": 10,
    "AllowedExtensions": [".pdf", ".doc", ".docx", ".ppt", ".pptx", ".xls", ".xlsx", ".jpg", ".jpeg", ".png", ".zip"]
  },
  "Tenant": {
    "DefaultTenantId": ""
  },
  "Frontend": {
    "Url": ""
  },
  "RateLimiting": {
    "PermitLimit": 200,
    "WindowMinutes": 1
  },
  "Backup": {
    "IntervalHours": 12,
    "RetentionDays": 14,
    "Path": "/var/backups/sms"
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://*:5000"
      },
      "Https": {
        "Url": "https://*:5001",
        "Certificate": {
          "Path": "",
          "Password": ""
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/sms/sms-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
