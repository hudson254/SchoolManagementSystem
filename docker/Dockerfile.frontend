# Build stage
FROM node:20-alpine AS build
WORKDIR /app

# Copy package files
COPY frontend/sms-web/package*.json ./
COPY frontend/sms-web/tsconfig*.json ./
COPY frontend/sms-web/vite.config.ts ./

# Install dependencies
RUN npm ci

# Copy source code
COPY frontend/sms-web/src ./src
COPY frontend/sms-web/public ./public
COPY frontend/sms-web/index.html ./

# Build the application
RUN npm run build

# Production stage
FROM nginx:alpine

# Copy built application
COPY --from=build /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/ || exit 1

# Start nginx
CMD ["nginx", "-g", "daemon off;"]