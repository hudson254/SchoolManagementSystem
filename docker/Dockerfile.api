# Build stage
FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

# Copy csproj files and restore dependencies
COPY ["src/SMS.API/SMS.API.csproj", "SMS.API/"]
COPY ["src/SMS.Application/SMS.Application.csproj", "SMS.Application/"]
COPY ["src/SMS.Domain/SMS.Domain.csproj", "SMS.Domain/"]
COPY ["src/SMS.Infrastructure/SMS.Infrastructure.csproj", "SMS.Infrastructure/"]
COPY ["src/SMS.Persistence/SMS.Persistence.csproj", "SMS.Persistence/"]
COPY ["src/SMS.Shared/SMS.Shared.csproj", "SMS.Shared/"]
COPY ["src/SMS.Identity/SMS.Identity.csproj", "SMS.Identity/"]
COPY ["src/SMS.Multitenancy/SMS.Multitenancy.csproj", "SMS.Multitenancy/"]
COPY ["src/SMS.Notifications/SMS.Notifications.csproj", "SMS.Notifications/"]
COPY ["src/SMS.Reporting/SMS.Reporting.csproj", "SMS.Reporting/"]

RUN dotnet restore "SMS.API/SMS.API.csproj"

# Copy all source code
COPY src/ .

# Publish the application
WORKDIR "/src/SMS.API"
RUN dotnet publish "SMS.API.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
EXPOSE 80

# Install curl for health checks
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Create a non-root user for security
RUN addgroup --system --gid 1001 appgroup && \
    adduser --system --uid 1001 --ingroup appgroup --no-create-home appuser

# Copy published application
COPY --from=build /app/publish .

# Set ownership to the non-root user
RUN chown -R appuser:appgroup /app

# Set environment variables
# The API runs HTTP-only behind an nginx reverse proxy that terminates TLS.
# Listening on HTTPS here would require a certificate that may not be
# available at deploy time; if Kestrel cannot load it, the entire process
# crashes (including the HTTP endpoint) and nginx returns 502.
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:80

# Switch to non-root user
USER appuser

# Health check — nginx/frontend depend on the API being ready to serve
# before they start proxying (avoids transient 502 during startup).
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
  CMD curl --silent --fail http://localhost/health || exit 1

# Entry point
ENTRYPOINT ["dotnet", "SMS.API.dll"]
