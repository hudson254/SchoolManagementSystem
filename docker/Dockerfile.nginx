FROM nginx:alpine

# Copy nginx configuration.
# nginx.conf is a complete config (events{} + http{}) with its own server
# blocks for SSL termination and reverse-proxying to the api/frontend
# containers. It does NOT include /etc/nginx/conf.d/*.conf, so
# nginx-frontend.conf is NOT copied here (it would be dead weight).
COPY docker/nginx.conf /etc/nginx/nginx.conf

# Create SSL directory
RUN mkdir -p /etc/ssl/certs /etc/ssl/private

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost/health || exit 1

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
